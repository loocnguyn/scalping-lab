# Supabase Postgres. Dung Session pooler (port 5432) hoac Direct connection.
# Transaction pooler (6543) KHONG dung duoc vi worker can prepared statements.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Binance USD-M Futures WebSocket. Doi sang testnet khi can:
# wss://stream.binancefuture.com/stream
BINANCE_WS_BASE=wss://fstream.binance.com/stream
SYMBOL=btcusdt

# Ghi DB theo lo
FLUSH_INTERVAL_MS=2000
LOG_LEVEL=info


# ---------------------------------------------------------------------------
# Thong bao Telegram khi co signal vao duoc
#
#   1. Telegram -> @BotFather -> /newbot -> dat ten -> copy token
#   2. NHAN TIN cho bot vua tao (bat ky tin gi). Bat buoc: Telegram khong cho bot
#      nhan tin truoc cho nguoi chua tung nhan tin cho no.
#   3. Mo https://api.telegram.org/bot<TOKEN>/getUpdates
#      lay so o result[0].message.chat.id
#
# Kiem tra: npm run test-telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_PER_HOUR=30
